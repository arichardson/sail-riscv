From f063a2cc85c837857bfd0b17827726836fb5244b Mon Sep 17 00:00:00 2001
From: Prashanth Mundkur <prashanth.mundkur@gmail.com>
Date: Fri, 30 Jan 2026 09:49:09 -0600
Subject: [PATCH] Ensure physical access and alignment checks are not bypassed
 for store-conditionals (#1500, #1603)

PR #861 refactored `STORECON` to go through `vmem_write`, which bypassed
`phys_access_check` when `match_reservation` failed (#1500) and bypassed
the alignment check when `plat_enable_misaligned_access` is enabled (#1603).

(cherry picked from commit f063a2cc85c837857bfd0b17827726836fb5244b)
(squashed with commit 59cfe00880a21128ed7eb99ddb90ec4bf2ce924b: Correctly raise misaligned access exceptions for store-conditional (#1603))
---
 model/riscv_vmem_utils.sail | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/model/riscv_vmem_utils.sail b/model/riscv_vmem_utils.sail
index 65003b58..73d50250 100644
--- a/model/riscv_vmem_utils.sail
+++ b/model/riscv_vmem_utils.sail
@@ -138,7 +138,13 @@ function vmem_write_addr(vaddr, width, data, acc, aq, rl, res) = {
       Ok(paddr, pbmt, _) => {
         /* If res is true, the load should be aligned, and this loop should only execute once */
         if res & not(match_reservation(bits_of(paddr))) then {
-          write_success = false
+          // Check PMA and PMP access controls before reporting the
+          // cancelled reservation.
+          let effPriv = effectivePrivilege(acc, mstatus, cur_privilege());
+          match phys_access_check(acc, effPriv, pbmt, paddr, bytes, true) {
+            Some(e) => return Err(Memory_Exception(Virtaddr(vaddr), e)),
+            None()  => write_success = false,
+          }
         } else match mem_write_ea(paddr, bytes, aq, rl, res) {
           Err(e) => return Err(Memory_Exception(Virtaddr(vaddr), e)),
 
@@ -251,7 +257,7 @@ function vmem_write(rs_addr, offset, width, data, acc, aq, rl, res) = {
     Ext_DataAddr_Error(e)  => return Err(Ext_DataAddr_Check_Failure(e)),
   };
 
-  if   check_misaligned(vaddr, width)
+  if   (res & not(is_aligned_addr(vaddr, width))) | check_misaligned(vaddr, width)
   then return Err(Memory_Exception(vaddr, E_SAMO_Addr_Align()));
 
   vmem_write_addr(vaddr, width, data, acc, aq, rl, res)
